:80 {
    # Global Security Headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Centralized Auth & Core Service
    handle_path /api/auth/* {
        reverse_proxy http://auth_service:8001
    }

    # Finance Service
    handle_path /api/finance/* {
        reverse_proxy http://finance_service:8002
    }

    # Chat Service (with streaming)
    handle_path /api/chat/* {
        reverse_proxy http://chat_service:8003 {
            flush_interval -1
        }
    }

    # Dora Clinical Service
    handle_path /api/dora/* {
        reverse_proxy http://dora_service:8004
    }

    # Presentation Studio Service
    handle_path /api/presentation/* {
        reverse_proxy http://presentation_service:8005
    }

    # Health probe
    handle /gateway-health {
        respond `{"status":"healthy","gateway":"caddy"}` 200
    }
}
