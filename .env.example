# =============================================================================
# Vitya.ai Environment Configuration Template (.env.example)
# Copy this file to .env and provide your actual API keys and secrets.
# Never commit real secret keys to source control.
# =============================================================================

# Platform Core & Security
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./vitya.db
# DATABASE_URL=postgresql://user:password@localhost:5432/vitya_db

# AI & Multimodal Intelligence
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# News APIs & Multi-Provider Aggregator
# -----------------------------------------------------------------------------
# Active provider strategy: 'auto' (fallback hierarchy), 'newsapi', 'mediastack', 'currents', 'web_fallback'
NEWS_PROVIDER=auto

# NewsAPI (https://newsapi.org)
NEWS_API_KEY=your_newsapi_org_api_key_here

# Mediastack (https://mediastack.com)
MEDIASTACK_API_KEY=your_mediastack_api_key_here

# Currents API (https://currentsapi.services)
CURRENTS_API_KEY=your_currents_api_key_here

# News Defaults & Reliability
NEWS_COUNTRY=in
NEWS_LANGUAGE=en
NEWS_REQUEST_TIMEOUT=10
NEWS_DEFAULT_LIMIT=5
NEWS_MAX_LIMIT=50
NEWS_CACHE_TTL=600

# -----------------------------------------------------------------------------
# Universal Web Information & Shopping Connectors (Optional Affiliate / Partner)
# -----------------------------------------------------------------------------
# Amazon Affiliate / Product Advertising API (PA-API v5)
AMAZON_AFFILIATE_TAG=your_amazon_associates_tag_here
AMAZON_ACCESS_KEY=your_amazon_paapi_access_key_here
AMAZON_SECRET_KEY=your_amazon_paapi_secret_key_here

# Flipkart Affiliate Platform
FLIPKART_AFFILIATE_ID=your_flipkart_affiliate_id_here
FLIPKART_AFFILIATE_TOKEN=your_flipkart_affiliate_token_here

# Open Government Data (OGD India / World Bank)
DATAGOV_IN_API_KEY=your_datagovin_api_key_here

# -----------------------------------------------------------------------------
# Additional External Services (Optional)
# -----------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here
